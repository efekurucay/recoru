{
  "manifest_version": 3,
  "name": "Recoru",
  "version": "2.0.1",
  "description": "Akor sitelerinde şarkı çalarken kayıtlarınızı anında, yerel olarak saklayın.",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "*://www.hakoru.net/*",
    "*://hakoru.net/*",
    "*://www.repertuarim.com/*",
    "*://repertuarim.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.hakoru.net/akor/*",
        "*://hakoru.net/akor/*",
        "*://www.repertuarim.com/akor/*",
        "*://repertuarim.com/akor/*"
      ],
      "js": ["src/storage/db.js", "src/content/ui.js", "src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/style.css"],
      "matches": [
        "*://www.hakoru.net/*",
        "*://hakoru.net/*",
        "*://www.repertuarim.com/*",
        "*://repertuarim.com/*"
      ]
    }
  ]
}
