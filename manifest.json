{
  "manifest_version": 3,
  "name": "Recoru",
  "version": "1.3",
  "description": "Akor sayfalarında ses kayıtlarınızı saklayın",
  "permissions": ["activeTab", "storage", "tabs"],
  "optional_permissions": ["microphone"],
  "host_permissions": [
    "*://www.hakoru.net/*",
    "*://hakoru.net/*",
    "*://www.repertuarim.com/*",
    "*://repertuarim.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.hakoru.net/akor/*",
        "*://hakoru.net/akor/*",
        "*://www.repertuarim.com/akor/*",
        "*://repertuarim.com/akor/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
